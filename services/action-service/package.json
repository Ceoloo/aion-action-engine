{
  "name": "@aion/action-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx src/db/migrate.ts && node --import tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@aion/actions": "workspace:*",
    "@aion/connectors": "workspace:*",
    "@aion/context": "workspace:*",
    "@aion/core": "workspace:*",
    "@aion/decision-engine": "workspace:*",
    "@aion/events": "workspace:*",
    "@aion/permissions": "workspace:*",
    "@aion/scoring": "workspace:*",
    "@hono/node-server": "^1.14.1",
    "better-sqlite3": "^11.9.1",
    "hono": "^4.7.5",
    "posthog-node": "^5.54.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
