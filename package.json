{
  "name": "aion-action-engine",
  "version": "0.1.0",
  "private": true,
  "description": "AION Action Queue — Signal → Recommendation → Action → Approval → Execution → Outcome",
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "build": "pnpm -r --filter=./packages/* build && pnpm --filter @aion/action-service build && pnpm --filter @aion/web build",
    "dev": "pnpm --filter @aion/action-service --filter @aion/web --parallel dev",
    "dev:api": "pnpm --filter @aion/action-service dev",
    "dev:web": "pnpm --filter @aion/web dev",
    "db:migrate": "pnpm --filter @aion/action-service db:migrate",
    "db:seed": "pnpm --filter @aion/action-service db:seed",
    "test": "pnpm -r --filter=./packages/* test && pnpm --filter @aion/action-service test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r --if-present lint"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
